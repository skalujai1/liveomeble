---
// Szkielet każdej strony: <head> (SEO + JSON-LD), skip-link, pasek DEMO, nagłówek, <main>, stopka,
// zgody cookies i leniwy doradca wnętrz.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/theme.css';
import '../styles/editorial.css';
import SeoHead from '../components/SeoHead.astro';
import DemoBar from '../components/DemoBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import AssistantLoader from '../components/AssistantLoader.astro';
import { DEMO } from '../config';
import { breadcrumbList, organization, website, type Crumb, type Node } from '../lib/jsonld';
import { site } from '../lib/site';

export interface Props {
  title: string;
  description: string;
  path: string;
  robots?: string;
  ogType?: 'website' | 'article' | 'product';
  ogImage?: string | null;
  ogImageAlt?: string;
  /** Węzły JSON-LD tej strony (WebSite i Organization dokładamy zawsze). */
  jsonLd?: Node[];
  /** Okruszki bez strony głównej — ostatni element to bieżąca strona. */
  breadcrumbs?: Crumb[];
  /** Klasa na <body> opisująca rodzaj strony (np. "page-product"). */
  pageClass?: string;
  /** Doradca wnętrz na stronie (domyślnie tak; wyłączony np. w strefie partnera). */
  assistant?: boolean;
  /** false = bez canonical (404). */
  canonical?: boolean;
  /** Hero na pełną szerokość pod przezroczystym nagłówkiem (slot "hero", przed okruszkami). */
  overlay?: boolean;
}

const { title, description, path, robots, ogType, ogImage: ogImageProp, ogImageAlt: ogAltProp, jsonLd = [], breadcrumbs, pageClass, assistant = true, canonical = true, overlay = false } = Astro.props;
// Brak własnego obrazu OG → obraz domyślny (aranżacja z logo, generowany: src/pages/og/[...slug].jpg.ts).
const ogImage = ogImageProp ?? '/og/liveo.jpg';
const ogImageAlt = ogImageProp ? ogAltProp : 'Liveo Meble — kolekcje mebli do całego domu';
const crumbs: Crumb[] | null = breadcrumbs?.length ? [{ name: site.breadcrumbs.home, url: '/' }, ...breadcrumbs] : null;
const ld: Node[] = [website(), organization(), ...jsonLd, ...(crumbs ? [breadcrumbList(path, crumbs)] : [])];
---
<!doctype html>
<html lang="pl" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <SeoHead {title} {description} {path} {robots} {ogType} {ogImage} {ogImageAlt} {canonical} jsonLd={ld} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#4a3427" />
    <link rel="preload" href="/fonts/onest-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gloock-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      /* Fonty self-hosted: podzbiór latin + osobny plik z polskimi znakami (ą ć ę ł ń ó ś ź ż). Licencja OFL: /fonts/OFL-*.txt */
      @font-face{font-family:"Onest";font-style:normal;font-weight:400 600;font-display:swap;src:url(/fonts/onest-latin.woff2) format("woff2");unicode-range:U+0020-007E,U+00A0-00FF,U+0131,U+0152-0153,U+02C6,U+02DA,U+02DC,U+2010-2027,U+2030-203A,U+20AC,U+2122,U+2190-2193,U+2212,U+2215}
      @font-face{font-family:"Onest";font-style:normal;font-weight:400 600;font-display:swap;src:url(/fonts/onest-pl.woff2) format("woff2");unicode-range:U+0104-0107,U+0118-0119,U+0141-0144,U+015A-015B,U+0179-017C}
      @font-face{font-family:"Gloock";font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/gloock-latin.woff2) format("woff2");unicode-range:U+0020-007E,U+00A0-00FF,U+0131,U+0152-0153,U+02C6,U+02DA,U+02DC,U+2010-2027,U+2030-203A,U+20AC,U+2122,U+2190-2193,U+2212,U+2215}
      @font-face{font-family:"Gloock";font-style:normal;font-weight:400;font-display:swap;src:url(/fonts/gloock-pl.woff2) format("woff2");unicode-range:U+0104-0107,U+0118-0119,U+0141-0144,U+015A-015B,U+0179-017C}
    </style>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body class:list={[pageClass, { 'has-overlay': overlay }]}>
    <a class="skip-link" href="#tresc">{site.skipLink}</a>
    {DEMO && <DemoBar />}
    <SiteHeader {path} />
    <main id="tresc" tabindex="-1">
      <slot name="hero" />
      {crumbs && <Breadcrumbs items={crumbs} />}
      <slot />
    </main>
    <SiteFooter />
    <ConsentBanner />
    {assistant && <AssistantLoader />}
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
