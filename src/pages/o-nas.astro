---
// O nas — docs/ia.md 3.13, treść: src/content/pages/o-nas.json (tylko potwierdzone fakty; reszta oznaczona [do potwierdzenia])
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContentSection from '../components/ContentSection.astro';
import Faq from '../components/Faq.astro';
import { faqPage, ORG_ID, webPage } from '../lib/jsonld';
import { pages, section, url } from '../lib/site';

const page = pages.oNas;
const path = url.about;
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  {path}
  pageClass="page-about"
  breadcrumbs={[{ name: 'O nas', url: path }]}
  jsonLd={[
    webPage('AboutPage', { path, title: page.seo.title, description: page.seo.description, hasBreadcrumb: true, extra: { about: { '@id': ORG_ID } } }),
    faqPage(path, page.faq.items),
  ]}
>
  <PageHeader h1={page.h1} lead={section(page, 'wstep').lead} />
  {page.sections.slice(1).map((s: any) => <ContentSection s={s} />)}
  <Faq title={page.faq.title} items={page.faq.items} />
</BaseLayout>
