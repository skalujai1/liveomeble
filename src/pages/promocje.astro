---
// Promocje — docs/ia.md 3.8, treść: src/content/pages/promocje.json
// Trwające i zaplanowane promocje są w HTML; przeglądarka pokazuje tylko te, które trwają TERAZ (scripts/prices.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ContentSection from '../components/ContentSection.astro';
import PromoCard from '../components/PromoCard.astro';
import ProductCard from '../components/ProductCard.astro';
import PriceData from '../components/PriceData.astro';
import Faq from '../components/Faq.astro';
import { faqPage, itemList, webPage } from '../lib/jsonld';
import { isActive, priceFor, promotionApplies } from '../lib/pricing.js';
import { BUILD_NOW, pages, productCount, productsSorted, section, upcomingOrActivePromos, url } from '../lib/site';
import { dateLong, fill } from '../lib/text';

const page = pages.promocje;
const path = url.promotions;
const intro = section(page, 'wstep');
const active = section(page, 'aktywne');

// Meble każdej promocji: największa obniżka kwotowo, maks. 8 (liczone dla chwili, w której promocja trwa).
const blocks = upcomingOrActivePromos.map(promo => {
  const at = isActive(promo, BUILD_NOW) ? BUILD_NOW : new Date(promo.startsAt);
  const items = productsSorted
    .filter(p => p.variants.some(v => promotionApplies(promo, p, v)))
    .map(p => {
      const r = priceFor(p, undefined, [promo], at);
      return { p, saving: r.regular ? r.regular - r.price : 0 };
    })
    .filter(x => x.saving > 0)
    .sort((a, b) => b.saving - a.saving);
  return { promo, items: items.slice(0, active.products.limit).map(x => x.p), total: items.length, activeNow: isActive(promo, BUILD_NOW) };
});
const onSaleNow = productsSorted.filter(p => blocks.some(b => b.activeNow && b.items.includes(p)));
const all = [...new Set(blocks.flatMap(b => b.items))];
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  {path}
  pageClass="page-promotions"
  breadcrumbs={[{ name: page.h1, url: path }]}
  jsonLd={[
    webPage('CollectionPage', { path, title: page.seo.title, description: page.seo.description, hasBreadcrumb: true }),
    itemList(path, onSaleNow.map(p => ({ url: url.product(p.slug), name: p.name })), 'Meble w promocji'),
    faqPage(path, page.faq.items),
  ]}
>
  <PageHeader h1={page.h1} lead={intro.lead}>
    <p class="page-meta" data-prices-updated data-template={intro.updated}>{fill(intro.updated, { date: dateLong(BUILD_NOW) })}</p>
  </PageHeader>

  {page.sections.slice(1).map((s: any) =>
    s.id === 'aktywne' ? (
      <Section id={s.id} title={s.title}>
        <div data-promo-group>
          <ul class="card-grid card-grid--promos">
            {blocks.map(b => <PromoCard promo={b.promo} count={productCount(b.total)} />)}
          </ul>
          <div class="listing__empty" data-promo-empty hidden={blocks.some(b => b.activeNow)}>
            <p><strong>{active.empty.title}</strong></p>
            <p>{active.empty.text}</p>
            <p><a class="btn btn--secondary" href={active.empty.cta.href}>{active.empty.cta.label}</a></p>
          </div>
          {blocks.map(b => (
            <div class="room-group" data-promo-window data-start={b.promo.startsAt ?? ''} data-end={b.promo.endsAt ?? ''} hidden={!b.activeNow}>
              <h3 class="room-group__title">{fill(active.products.title, { label: b.promo.label })}</h3>
              <ul class="product-grid">
                {b.items.map((p, i) => <ProductCard product={p} headingLevel={4} order={i} />)}
              </ul>
            </div>
          ))}
        </div>
        <p class="section__more"><a href="/meble/?promocje=1">Wszystkie meble w promocji</a></p>
      </Section>
    ) : <ContentSection s={s} />,
  )}

  <Faq title={page.faq.title} items={page.faq.items} />
  <PriceData products={all} />
</BaseLayout>
