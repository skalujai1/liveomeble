---
// Kolekcja — docs/ia.md 3.3, szablon: src/content/pages/kolekcje.json → template.
// Układ premium (surface brief: .impeccable/surfaces/src-pages-index-astro.md): hero na cały ekran pod przezroczystym
// nagłówkiem → opis i szczegóły → galeria aranżacji z kart Liveo → meble → kolory → gdzie kupić →
// inne kolekcje w pasie → doradca → FAQ.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionHero from '../../components/CollectionHero.astro';
import CollectionRail from '../../components/CollectionRail.astro';
import Media from '../../components/Media.astro';
import Section from '../../components/Section.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import StoreFinder from '../../components/StoreFinder.astro';
import Faq from '../../components/Faq.astro';
import Rich from '../../components/Rich.astro';
import { collectionImage, collectionImages } from '../../lib/images';
import { faqPage, itemList, webPage } from '../../lib/jsonld';
import {
  collections, finishById, finishLabelsSentence, pages, productCount,
  productsByCollection, roomBySlug, rooms, roomsList, styleOf, typePluralList, types, url, type Collection, type Product,
} from '../../lib/site';
import { fill, truncateSentence } from '../../lib/text';

export function getStaticPaths() {
  return collections.map(c => ({ params: { slug: c.slug }, props: { c } }));
}
interface Props { c: Collection }
const { c } = Astro.props;
const tpl = pages.kolekcje.template;
const sec = (id: string) => tpl.sections.find(s => s.id === id) as any;
const path = url.collection(c.slug);
const style = styleOf(c);
const heroRoom = roomBySlug.get(c.heroRoom)!;
const list = productsByCollection(c.slug);
const vars = {
  name: c.name, slug: c.slug, tagline: c.tagline, description: c.description, styleIn: style.in, styleLabel: style.label,
  roomsList: roomsList(c.rooms), finishLabels: finishLabelsSentence(c), heroRoomLocative: heroRoom.locative,
  finishLabel: c.finishes[0].label.toLocaleLowerCase('pl'), productCountText: productCount(list.length),
  delivery72Text: (() => { const n = list.filter(p => p.delivery72).length; return n === list.length ? 'wszystkie meble' : n ? `${productCount(n)} z ${list.length}` : 'nie'; })(),
  typePluralList: typePluralList([...new Set(list.map(p => p.type))]),
};
let title = fill(tpl.seo.title, vars);
if (title.length > 60) title = fill(tpl.seo.titleFallback, vars);
const description = truncateSentence(fill(tpl.seo.description, vars), 155);
const h1 = fill(tpl.h1, vars);

// Meble pogrupowane po pomieszczeniach (każdy mebel raz — w pierwszym swoim pomieszczeniu z kolekcji).
const groups = rooms
  .filter(r => c.rooms.includes(r.slug))
  .map(r => ({ room: r, items: [] as Product[] }));
for (const p of list) {
  const g = groups.find(x => p.rooms.includes(x.room.slug)) ?? groups[0];
  g.items.push(p);
}
const typeLinks = types.filter(t => list.some(p => p.type === t.id));

// Pozostałe kolekcje: najpierw podobne (wspólne pomieszczenia +1, ten sam styl +2), potem reszta.
const others = collections
  .filter(x => x.slug !== c.slug)
  .map(x => ({ x, score: x.rooms.filter(r => c.rooms.includes(r)).length + (x.style === c.style ? 2 : 0) }))
  .sort((a, b) => b.score - a.score || a.x.order - b.x.order)
  .map(o => o.x);

const faq = tpl.faq.items.map(it => ({ q: fill(it.q, vars), a: fill(it.a, vars) }));
const heroAlt = fill(sec('hero').image.alt, vars);
const swatch = (id?: string | null) => (id ? finishById.get(id)?.hex : undefined);
// Galeria: aranżacje z kart Liveo (bez pierwszej — jest w hero); układ wide / detal / pod kątem, reszta w rzędzie.
const all = collectionImages(c);
const rest = all.length > 1 ? all.slice(1) : all;
const [gWide, gDetail, gAngle, ...gMore] = rest;
---
<BaseLayout
  {title}
  {description}
  {path}
  pageClass="page-collection"
  overlay
  ogImage={collectionImage(c, 'wide') ? `/og/kolekcje/${c.slug}.jpg` : undefined}
  ogImageAlt={`Kolekcja ${c.name} — aranżacja`}
  breadcrumbs={[{ name: 'Kolekcje', url: url.collections }, { name: c.name, url: path }]}
  jsonLd={[
    webPage('CollectionPage', { path, title, description, hasBreadcrumb: true }),
    itemList(path, list.map(p => ({ url: url.product(p.slug), name: p.name })), h1),
    faqPage(path, faq),
  ]}
>
  <CollectionHero slot="hero" collection={c} {h1} alt={heroAlt} />

  <section class="section collection-intro" id="opis" aria-labelledby="opis-tytul">
    <div class="container collection-intro__inner">
      <div data-reveal>
        <h2 class="collection-intro__title" id="opis-tytul">{fill(sec('opis').title, vars)}</h2>
        <p class="collection-intro__text"><Rich text={c.description} /></p>
      </div>
      <div data-reveal style="--d: 120ms">
        <h3 class="collection-intro__facts-title">{sec('szczegoly').title}</h3>
        <dl class="facts collection-intro__facts">
          {sec('szczegoly').items.map((it: any) => (
            <div class="facts__row"><dt>{it.label}</dt><dd>{fill(it.value, vars)}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="collection-gallery" aria-label={`Kolekcja ${c.name} w aranżacji`}>
    <div class="container collection-gallery__grid">
      {gWide && (
        <figure class="collection-gallery__item collection-gallery__item--wide" data-reveal>
          <Media image={gWide} alt={`Kolekcja ${c.name} w aranżacji`} widths={[1280, 2400]} sizes="(min-width: 80rem) 76rem, 100vw" ratio="16 / 9" placeholderLabel={`Kolekcja ${c.name}`} />
        </figure>
      )}
      {gDetail && (
        <figure class="collection-gallery__item collection-gallery__item--detail" data-reveal>
          <Media image={gDetail} alt={`Kolekcja ${c.name} — kolejna aranżacja`} widths={[1280]} sizes="(min-width: 64rem) 31vw, 50vw" ratio="4 / 5" placeholderLabel={`Kolekcja ${c.name}`} />
        </figure>
      )}
      {gAngle && (
        <figure class="collection-gallery__item collection-gallery__item--angle" data-reveal style="--d: 120ms">
          <Media image={gAngle} alt={`Kolekcja ${c.name} — kolejna aranżacja`} widths={[1280, 2400]} sizes="(min-width: 64rem) 52vw, 100vw" ratio="3 / 2" placeholderLabel={`Kolekcja ${c.name}`} />
        </figure>
      )}
      {gMore.map(g => (
        <figure class="collection-gallery__item collection-gallery__item--more" data-reveal>
          <Media image={g} alt={`Kolekcja ${c.name} — aranżacja`} widths={[1280]} sizes="(min-width: 64rem) 38vw, 100vw" ratio="3 / 2" placeholderLabel={`Kolekcja ${c.name}`} />
        </figure>
      ))}
      <p class="collection-gallery__caption">Aranżacje z materiałów Liveo. Kolory na ekranie mogą nieco różnić się od rzeczywistych.</p>
    </div>
  </section>

  <Section id="meble" title={fill(sec('meble').title, vars)} lead={`W kolekcji: ${productCount(list.length)}.`}>
    {groups.filter(gr => gr.items.length).map(gr => (
      <div class="room-group">
        <h3 class="room-group__title">{gr.room.name}</h3>
        <ProductGrid products={gr.items} headingLevel={4} />
        <p class="section__more"><a href={url.room(gr.room.slug)}>Wszystkie meble do pomieszczenia: {gr.room.name}</a></p>
      </div>
    ))}
    <p class="section__note">Rodzaje mebli w kolekcji {c.name}:</p>
    <ul class="link-list">{typeLinks.map(t => <li><a href={url.category(t.slug)}>{t.plural}</a></li>)}</ul>
  </Section>

  <Section id="kolory" title={fill(sec('kolory').title, vars)} lead={sec('kolory').lead} class="section--alt">
    <ul class="swatches">
      {c.finishes.map(f => {
        const a = swatch(f.front) ?? '#ccc';
        const b = swatch(f.body) ?? a;
        return (
          <li class="swatches__item">
            <span class="swatches__chip swatches__chip--split" style={`--swatch: ${a}; --swatch-2: ${b}`} aria-hidden="true"></span>
            <span>{fill(sec('kolory').item, { label: f.label })}</span>
          </li>
        );
      })}
    </ul>
  </Section>

  <Section id="gdzie-kupic" title={fill(sec('gdzie-kupic').title, vars)} lead={sec('gdzie-kupic').lead}>
    <StoreFinder id="sklepy-kolekcja" presetCollection={c.slug} limit={3} more={{ label: 'Więcej sklepów z tą kolekcją', href: url.stores(c.slug) }} />
  </Section>

  <section class="section rail-section" aria-labelledby="podobne-tytul" id="podobne">
    <header class="container rail-section__head" data-reveal>
      <h2 class="rail-section__title" id="podobne-tytul">{sec('podobne').title}</h2>
      <a class="link" href={url.collections}>Wszystkie kolekcje</a>
    </header>
    <CollectionRail collections={others} label="Inne kolekcje Liveo" />
  </section>

  <Section id="doradca" title="Nie wiesz, który kolor wybrać?" class="section--band">
    <div class="band"><p class="band__text">Wyślij zdjęcie pokoju — doradca wnętrz podpowie kolor kolekcji {c.name} pasujący do podłogi i ścian.</p></div>
    <p class="cta-row"><a class="btn btn--secondary" href={url.advisor}>Doradca wnętrz</a></p>
  </Section>

  <Faq title={fill(tpl.faq.title, vars)} items={faq} />
</BaseLayout>
