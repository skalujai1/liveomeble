---
// Wszystkie kolekcje — docs/ia.md 3.2, treść: src/content/pages/kolekcje.json
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import ContentSection from '../../components/ContentSection.astro';
import CollectionSpread from '../../components/CollectionSpread.astro';
import Faq from '../../components/Faq.astro';
import { faqPage, itemList, webPage } from '../../lib/jsonld';
import { collections, pages, rooms, section, url } from '../../lib/site';

const page = pages.kolekcje;
const path = url.collections;
const intro = section(page, 'wstep');
const lista = section(page, 'lista');
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  {path}
  pageClass="page-collections"
  breadcrumbs={[{ name: page.h1.replace(' mebli Liveo', ''), url: path }]}
  jsonLd={[
    webPage('CollectionPage', { path, title: page.seo.title, description: page.seo.description, hasBreadcrumb: true }),
    itemList(path, collections.map(c => ({ url: url.collection(c.slug), name: `Kolekcja ${c.name}` })), page.h1),
    faqPage(path, page.faq.items),
  ]}
>
  <PageHeader h1={page.h1} lead={intro.lead} />

  {page.sections.slice(1).map((s: any) =>
    s.id === 'lista' ? (
      <Section id={s.id} title={s.title} titleHidden={s.titleVisuallyHidden}>
        <fieldset class="chip-filter" data-collection-filter hidden>
          <legend class="chip-filter__legend">{lista.filter.label}</legend>
          <label class="check"><input type="radio" name="kolekcje-pokoj" value="" checked /> <span>{lista.filter.all}</span></label>
          {rooms.map(r => <label class="check"><input type="radio" name="kolekcje-pokoj" value={r.slug} /> <span>{r.name}</span></label>)}
        </fieldset>
        <p class="visually-hidden" role="status" aria-live="polite" data-collection-filter-status></p>
        <ul class="spreads__list spreads__list--page" data-collection-list>
          {collections.map((c, i) => <li data-rooms={c.rooms.join(' ')}><CollectionSpread collection={c} flip={i % 2 === 1} headingLevel={s.title ? 3 : 2} /></li>)}
        </ul>
      </Section>
    ) : <ContentSection s={s} />,
  )}

  <Faq title={page.faq.title} items={page.faq.items} />
</BaseLayout>

<script>
  // Filtr kolekcji po pomieszczeniu — w przeglądarce, bez zmiany adresu (docs/ia.md 3.2).
  const box = document.querySelector<HTMLElement>('[data-collection-filter]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-collection-list] > li')];
  const status = document.querySelector<HTMLElement>('[data-collection-filter-status]');
  if (box) {
    box.hidden = false;
    box.addEventListener('change', e => {
      const room = (e.target as HTMLInputElement).value;
      let n = 0;
      for (const c of cards) {
        const ok = !room || (c.dataset.rooms ?? '').split(' ').includes(room);
        c.hidden = !ok;
        if (ok) n++;
      }
      if (status) status.textContent = `Pokazane kolekcje: ${n}`;
    });
  }
</script>
