---
// Strona główna — układ kierunku A (design/directions-v2/a): hero ze ściętą plakietką hasła, pas usług,
// kolekcje, polecane meble, rodzaje mebli, gdzie kupić, pas B2B, poradnik, FAQ.
// Treść: src/content/pages/home.json, dane: src/data. Docs: docs/ia.md 3.1.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import HeroPicture from '../components/HeroPicture.astro';
import CollectionCard from '../components/CollectionCard.astro';
import ProductCard from '../components/ProductCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StoreFinder from '../components/StoreFinder.astro';
import PriceData from '../components/PriceData.astro';
import Faq from '../components/Faq.astro';
import Media from '../components/Media.astro';
import Rich from '../components/Rich.astro';
import { articleCard, getArticles } from '../lib/articles';
import { collectionImage, roomImage, typeImage } from '../lib/images';
import { faqPage } from '../lib/jsonld';
import { formatPrice } from '../lib/pricing.js';
import { activePromosAtBuild, collections, pages, priceAt, products, productsByCollection, productsSorted, section, types, url } from '../lib/site';
import { fill, promoLastDay } from '../lib/text';

const page = pages.home;
const hero = section(page, 'hero');
const kol = section(page, 'kolekcje');
const steps = section(page, 'jak-kupic');
const b2b = section(page, 'partnerzy');
const guides = section(page, 'poradnik');
const path = '/';

// Hero: pierwsza kolekcja, jej aranżacja i mebel na zdjęciu.
const first = collections[0];
const heroWide = collectionImage(first, 'wide')!;
const heroTall = collectionImage(first, 'tall');
const firstColor = first.finishes[0].label.toLocaleLowerCase('pl');
const heroAlt = heroWide?.approximate && heroWide.title
  ? `Aranżacja poglądowa: ${heroWide.title}`
  : fill(hero.image.alt, { name: first.name, color: firstColor });
const heroProduct = productsByCollection(first.slug).find(p => p.type === 'rtv') ?? productsByCollection(first.slug)[0];
const heroPrice = priceAt(heroProduct);
const heroPromo = activePromosAtBuild.find(p => (p.scope as { collections?: string[] }).collections?.includes(first.slug));
const heroLastDay = promoLastDay(heroPromo?.endsAt);
// promoLastDay zwraca „RRRR-MM-DD” (dzień w czasie polskim) → „30.10”.
const dayMonth = (d: string | null) => (d ? `${Number(d.slice(8, 10))}.${d.slice(5, 7)}` : '');

// Pas usług: aktywna promocja z najwcześniejszym końcem.
const mainPromo = activePromosAtBuild[0];

// Kolekcje: 4 pierwsze (wszystkie na /kolekcje/).
const homeCollections = collections.slice(0, 4);

// Polecane: bestsellery, potem promocje i nowości — każdy mebel z innej kolekcji i innego rodzaju.
const seenCol = new Set<string>();
const seenType = new Set<string>();
const featured = [...productsSorted]
  .sort((a, b) => (Number(b.bestseller) - Number(a.bestseller)) || (Number(!!priceAt(b).promo) - Number(!!priceAt(a).promo)) || (Number(b.isNew) - Number(a.isNew)))
  .filter(p => {
    if (seenCol.has(p.collection) || seenType.has(p.type)) return false;
    seenCol.add(p.collection); seenType.add(p.type); return true;
  })
  .slice(0, 4);

// Rodzaje mebli: 8 z packshotem.
// Rodzaje mebli: najpierw te ze zdjęciem (bez pustych kafli), maks. 8.
const tileTypes = types.filter(t => products.some(p => p.type === t.id)).map(t => ({ t, img: typeImage(t.id, products) })).filter(x => x.img).slice(0, 8);
const typeCount = types.filter(t => products.some(p => p.type === t.id)).length;

const b2bImg = roomImage('przedpokoj', 'wide');
const articles = (await getArticles()).slice(0, 4).map(articleCard);
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  {path}
  pageClass="page-home"
  ogImage={null}
  jsonLd={[faqPage(path, page.faq.items)]}
>
  <section class="home-hero" aria-labelledby="h1">
    <div class="container">
      <div class="home-hero__box">
        <HeroPicture wide={heroWide} tall={heroTall} alt={heroAlt} class="home-hero__media" />
        <a class="home-hero__tag" href={url.product(heroProduct.slug)}>
          <i aria-hidden="true"></i>
          <span><b>{heroProduct.name}</b><em class:list={{ 'is-promo': !!heroPrice.promo }}>{formatPrice(heroPrice.price)}</em></span>
        </a>
        <div class="home-hero__card on-dark">
          <h1 class="home-hero__title" id="h1"><Rich text={page.h1} /></h1>
          <p class="home-hero__lead">
            Kolekcja {first.name} w kolorze {firstColor}{heroPromo && (
              <span data-promo-window data-start={heroPromo.startsAt ?? ''} data-end={heroPromo.endsAt ?? ''}>, teraz {heroPromo.value}% taniej{heroLastDay && ` do ${dayMonth(heroLastDay)}`}</span>
            )}.
          </p>
          <p class="home-hero__cta">
            <a class="btn btn--primary" href={url.collection(first.slug)}>Zobacz kolekcję {first.name}</a>
            <a class="link" href={url.stores()}>
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.4" /></svg>
              Gdzie kupić
            </a>
          </p>
        </div>
      </div>

      <div class="services">
        <form class="service" action={url.stores()} method="get">
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.4" /></svg>
          <label for="usluga-kod"><b>Gdzie kupić</b><span class="visually-hidden"> — wpisz kod pocztowy</span></label>
          <div class="service__code">
            <input id="usluga-kod" name="kod" type="text" inputmode="numeric" autocomplete="postal-code" placeholder="__-___" maxlength="6" />
            <button type="submit">Szukaj</button>
          </div>
        </form>
        <a class="service" href={url.advisor}>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z" /><circle cx="12" cy="13" r="3.2" /></svg>
          <b>Doradca wnętrz</b><span>Dobierz meble do zdjęcia pokoju</span>
        </a>
        <a class="service" href={url.promotions}>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12V4h8l9 9-8 8z" /><circle cx="7.5" cy="8.5" r="1.4" /></svg>
          <b>Promocje</b>
          <span>{mainPromo
            ? <span data-promo-window data-start={mainPromo.startsAt ?? ''} data-end={mainPromo.endsAt ?? ''}><em>{mainPromo.label}</em>{promoLastDay(mainPromo.endsAt) && ` do ${dayMonth(promoLastDay(mainPromo.endsAt))}`}</span>
            : 'Aktualne obniżki cen'}</span>
        </a>
        <a class="service" href={url.partners}>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 10 5 5h14l2 5M4 10v9h16v-9M3 10h18M9 19v-5h6v5" /></svg>
          <b>Dla sklepów</b><span>Zostań partnerem Liveo</span>
        </a>
      </div>
    </div>
  </section>

  <Section id={kol.id} title="Nasze kolekcje" lead={kol.lead} class="section--alt section--center">
    <ul class="card-grid card-grid--collections">
      {homeCollections.map(c => <CollectionCard collection={c} showFoot />)}
    </ul>
    <p class="section__more"><a href={kol.more.href}>Zobacz wszystkie {collections.length} kolekcji</a></p>
  </Section>

  <Section id="polecane" title="Polecane meble" lead="Ceny sugerowane przez producenta. Meble kupisz w salonach partnerskich." class="section--center">
    <ul class="product-grid product-grid--4">
      {featured.map((p, i) => <ProductCard product={p} order={i} sizes="(min-width: 60rem) 18rem, 46vw" />)}
    </ul>
    <p class="section__more"><a href={url.products}>Wszystkie meble</a></p>
  </Section>

  <Section id="rodzaje" title="Wybierz rodzaj mebla" class="section--center">
    <ul class="type-tiles">
      {tileTypes.map(({ t, img }) => (
        <li class="type-tile"><a href={url.category(t.slug)}>
          <span class="type-tile__thumb">{img && <Image src={img.src} alt="" widths={[160, 240, 320]} sizes="(min-width: 60rem) 9rem, 22vw" loading="lazy" />}</span>
          <span class="type-tile__name">{t.plural}</span>
        </a></li>
      ))}
    </ul>
    <p class="section__more"><a href={url.products}>Wszystkie {typeCount} rodzajów mebli</a></p>
  </Section>

  <Section id="gdzie-kupic" title="Znajdź salon partnerski" lead={steps.lead} class="section--alt section--center">
    <StoreFinder id="salony-home" limit={3} headingLevel={3} more={{ label: 'Wszystkie salony na mapie', href: url.stores() }} />
    <ol class="buy-steps">
      {steps.items.map((it: any) => (
        <li><h3><Rich text={it.title} /></h3><p><Rich text={it.text} /></p></li>
      ))}
    </ol>
  </Section>

  <section class="band-dark on-dark" id={b2b.id} aria-labelledby="b2b-tytul">
    <div class="container band-dark__inner">
      <div>
        <h2 id="b2b-tytul"><Rich text={b2b.title} /></h2>
        <p><Rich text={b2b.text} /></p>
        <ul>
          {['Twój salon w wyszukiwarce „Gdzie kupić”', 'Cennik partnerski i stany magazynowe online', 'Zamówienia przez strefę partnera'].map(t => (
            <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg>{t}</li>
          ))}
        </ul>
        <p class="cta-row">
          <a class="btn btn--primary" href={url.partners}>{b2b.cta.label}</a>
          <a class="btn btn--light" href={url.partnerZone}>Strefa partnera</a>
        </p>
      </div>
      <Media image={b2bImg} alt="" widths={[480, 768, 1024]} sizes="(min-width: 60rem) 38rem, 100vw" ratio="16 / 10" placeholderLabel="Aranżacja" />
    </div>
  </section>

  <Section id={guides.id} title={guides.title} lead={guides.lead} class="section--center">
    <ul class="card-grid card-grid--articles">
      {articles.map(a => <ArticleCard article={a} />)}
    </ul>
    <p class="section__more"><a href={guides.cta.href}>{guides.cta.label}</a></p>
  </Section>

  <Faq title={page.faq.title} items={page.faq.items} />
  <PriceData products={featured} />
</BaseLayout>
