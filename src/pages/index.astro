---
// Strona główna — docs/ia.md 3.1, treść: src/content/pages/home.json
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ContentSection from '../components/ContentSection.astro';
import CollectionCard from '../components/CollectionCard.astro';
import RoomCard from '../components/RoomCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import PromoCard from '../components/PromoCard.astro';
import PriceData from '../components/PriceData.astro';
import Faq from '../components/Faq.astro';
import { articleCard, getArticles } from '../lib/articles';
import { collectionImage } from '../lib/images';
import { faqPage } from '../lib/jsonld';
import { activePromosAtBuild, collections, pages, rooms, section, upcomingOrActivePromos } from '../lib/site';
import { fill } from '../lib/text';

const page = pages.home;
const hero = section(page, 'hero');
const first = collections[0];
const heroImg = collectionImage(first, 'wide');
const firstColor = first.finishes[0].label.toLocaleLowerCase('pl');
const heroAlt = heroImg?.approximate && heroImg.title
  ? `Aranżacja poglądowa: ${heroImg.title}`
  : fill(hero.image.alt, { name: first.name, color: firstColor });
const articles = (await getArticles()).slice(0, 4).map(articleCard);
const promos = section(page, 'promocje');
const path = '/';
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  {path}
  pageClass="page-home"
  ogImage={null}
  jsonLd={[faqPage(path, page.faq.items)]}
>
  <PageHeader h1={page.h1} lead={hero.lead} ctas={hero.cta} image={heroImg} imageAlt={heroAlt} placeholderLabel="Aranżacja wnętrza" />

  {page.sections.slice(1).map((s: any) => {
    if (s.type === 'collections') return (
      <Section id={s.id} title={s.title} lead={s.lead}>
        <ul class="card-grid card-grid--collections">
          {collections.map(c => <CollectionCard collection={c} />)}
        </ul>
        <p class="section__more"><a href={s.more.href}>{s.more.label}</a></p>
      </Section>
    );
    if (s.type === 'rooms') return (
      <Section id={s.id} title={s.title} lead={s.lead}>
        <ul class="card-grid card-grid--rooms">
          {rooms.map(r => <RoomCard room={r} />)}
        </ul>
      </Section>
    );
    if (s.type === 'promotions') return (
      <div data-promo-group data-promo-hide-empty hidden={activePromosAtBuild.length === 0}>
        <Section id={s.id} title={s.title} lead={s.lead}>
          <ul class="card-grid card-grid--promos">
            {upcomingOrActivePromos.map(p => <PromoCard promo={p} />)}
          </ul>
          <p class="section__more"><a href={s.cta.href}>{s.cta.label}</a></p>
        </Section>
      </div>
    );
    if (s.type === 'articles') return (
      <Section id={s.id} title={s.title} lead={s.lead}>
        <ul class="card-grid card-grid--articles">
          {articles.map(a => <ArticleCard article={a} />)}
        </ul>
        <p class="section__more"><a href={s.cta.href}>{s.cta.label}</a></p>
      </Section>
    );
    return <ContentSection s={s} />;
  })}

  <Faq title={page.faq.title} items={page.faq.items} />
  {promos && <PriceData products={[]} />}
</BaseLayout>
