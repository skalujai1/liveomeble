---
// Strona główna — styl C na poziomie „premium” (surface brief: .impeccable/surfaces/src-pages-index-astro.md):
// kurtyna kolekcji na cały ekran → manifest (H1) → rozkładówki trzech kolekcji → pas wszystkich kolekcji →
// pomieszczenia → polecane meble → doradca → gdzie kupić → B2B → rodzaje mebli → poradnik → FAQ.
// Treść: src/content/pages/home.json, dane: src/data. Docs: docs/ia.md 3.1.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import HomeHero from '../components/HomeHero.astro';
import CollectionSpread from '../components/CollectionSpread.astro';
import CollectionRail from '../components/CollectionRail.astro';
import RoomShowcase from '../components/RoomShowcase.astro';
import ProductCard from '../components/ProductCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StoreFinder from '../components/StoreFinder.astro';
import PriceData from '../components/PriceData.astro';
import Faq from '../components/Faq.astro';
import Media from '../components/Media.astro';
import Rich from '../components/Rich.astro';
import { articleCard, getArticles } from '../lib/articles';
import { collectionImage, roomImage, typeImage } from '../lib/images';
import { faqPage } from '../lib/jsonld';
import { activePromosAtBuild, collections, pages, priceAt, products, productsSorted, section, types, url } from '../lib/site';
import { promoLastDay } from '../lib/text';

const page = pages.home;
const hero = section(page, 'hero');
const kol = section(page, 'kolekcje');
const pom = section(page, 'pomieszczenia');
const steps = section(page, 'jak-kupic');
const b2b = section(page, 'partnerzy');
const guides = section(page, 'poradnik');
const path = '/';

// Rozkładówki: pierwsza kolekcja, najnowsza i kolejna z innego pomieszczenia — trzy różne nastroje.
const first = collections[0];
const fresh = collections.find(c => c.isNew && c.slug !== first.slug);
const third = collections.find(c => c.slug !== first.slug && c.slug !== fresh?.slug && c.heroRoom !== first.heroRoom && c.heroRoom !== fresh?.heroRoom);
const spreads = [first, fresh, third].filter((c): c is NonNullable<typeof c> => !!c);

const mainPromo = activePromosAtBuild[0];
const dayMonth = (d: string | null) => (d ? `${Number(d.slice(8, 10))}.${d.slice(5, 7)}` : '');

// Polecane: bestsellery, potem promocje i nowości — każdy mebel z innej kolekcji i innego rodzaju.
const seenCol = new Set<string>();
const seenType = new Set<string>();
const featured = [...productsSorted]
  .sort((a, b) => (Number(b.bestseller) - Number(a.bestseller)) || (Number(!!priceAt(b).promo) - Number(!!priceAt(a).promo)) || (Number(b.isNew) - Number(a.isNew)))
  .filter(p => {
    if (seenCol.has(p.collection) || seenType.has(p.type)) return false;
    seenCol.add(p.collection); seenType.add(p.type); return true;
  })
  .slice(0, 4);

const tileTypes = types.filter(t => products.some(p => p.type === t.id)).map(t => ({ t, img: typeImage(t.id, products) })).filter(x => x.img).slice(0, 8);
const typeCount = types.filter(t => products.some(p => p.type === t.id)).length;

const advisorCol = collections.find(c => c.slug === 'nokta') ?? collections[1];
const advisorImg = collectionImage(advisorCol, 'detail');
const b2bImg = roomImage('przedpokoj', 'wide');
const articles = (await getArticles()).slice(0, 4).map(articleCard);
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  {path}
  pageClass="page-home"
  overlay
  ogImage="/og/liveo.jpg"
  ogImageAlt={`Meble z kolekcji ${first.name}`}
  jsonLd={[faqPage(path, page.faq.items)]}
>
  <HomeHero slot="hero" {collections} />

  <section class="manifest" aria-labelledby="h1">
    <div class="container manifest__inner">
      <h1 class="manifest__title" id="h1" data-reveal><Rich text={page.h1} /></h1>
      <div class="manifest__side" data-reveal style="--d: 120ms">
        <p class="manifest__lead"><Rich text={hero.lead} /></p>
        <p class="manifest__cta">
          {hero.cta.map((c: any, i: number) => <a class:list={['btn', i ? 'btn--secondary' : 'btn--dark']} href={c.href}>{c.label}</a>)}
        </p>
      </div>
    </div>
    <nav class="container manifest__services" aria-label="Na skróty" data-reveal style="--d: 200ms">
      <a href={url.advisor}><b>Doradca wnętrz</b><span>Dobierz meble do zdjęcia pokoju</span></a>
      <a href={url.promotions}>
        <b>Promocje</b>
        <span>{mainPromo
          ? <span data-promo-window data-start={mainPromo.startsAt ?? ''} data-end={mainPromo.endsAt ?? ''}><em>{mainPromo.label}</em>{promoLastDay(mainPromo.endsAt) && ` do ${dayMonth(promoLastDay(mainPromo.endsAt))}`}</span>
          : 'Aktualne obniżki cen'}</span>
      </a>
      <a href={url.stores()}><b>Gdzie kupić</b><span>Salony partnerskie w całej Polsce</span></a>
      <a href={url.partners}><b>Dla sklepów</b><span>Zostań partnerem Liveo</span></a>
    </nav>
  </section>

  <section class="spreads" id={kol.id} aria-labelledby="kolekcje-tytul">
    <header class="container spreads__head" data-reveal>
      <h2 class="spreads__title" id="kolekcje-tytul">{kol.title}</h2>
      <p class="spreads__lead">{kol.lead}</p>
    </header>
    <div class="container spreads__list">
      {spreads.map((c, i) => <CollectionSpread collection={c} flip={i % 2 === 1} headingLevel={3} />)}
    </div>
  </section>

  <section class="section rail-section" aria-labelledby="wszystkie-tytul">
    <header class="container rail-section__head" data-reveal>
      <h2 class="rail-section__title" id="wszystkie-tytul">Wszystkie kolekcje</h2>
      <a class="link" href={kol.more.href}>{kol.more.label}</a>
    </header>
    <CollectionRail {collections} named={spreads.map(c => c.slug)} label="Kolekcje Liveo" />
  </section>

  <section class="section rooms-section" aria-labelledby="pomieszczenia-tytul">
    <div class="container">
      <header class="rooms-section__head" data-reveal>
        <h2 id="pomieszczenia-tytul"><Rich text={pom.title} /></h2>
        <p class="section__lead">{pom.lead}</p>
      </header>
      <RoomShowcase />
    </div>
  </section>

  <Section id="polecane" title="Polecane meble" lead="Ceny sugerowane przez producenta. Meble kupisz w salonach partnerskich." class="section--center section--products">
    <ul class="product-grid product-grid--4">
      {featured.map((p, i) => <ProductCard product={p} order={i} sizes="(min-width: 60rem) 18rem, 46vw" />)}
    </ul>
    <p class="section__more"><a href={url.products}>Wszystkie meble</a></p>
  </Section>

  <section class="feature-band on-dark" aria-labelledby="doradca-tytul">
    <div class="feature-band__media" data-reveal>
      <Media image={advisorImg} alt="" widths={[720, 1080, 1440, 1920]} sizes="(min-width: 60rem) 50vw, 100vw" ratio="4 / 5" placeholderLabel="Doradca wnętrz" />
    </div>
    <div class="feature-band__text" data-reveal style="--d: 120ms">
      <h2 id="doradca-tytul">Pokaż pokój, a dobierzemy komplet</h2>
      <p>Doradca wnętrz rozpozna pomieszczenie i jego kolory, a potem zaproponuje meble z jednej kolekcji, które do nich pasują. Zdjęcie zostaje na Twoim urządzeniu.</p>
      <p class="cta-row">
        <a class="btn btn--white" href={url.advisor}>Otwórz doradcę wnętrz</a>
        <a class="link" href={`${url.advisor}#jak-korzystac`}>Jak to działa</a>
      </p>
    </div>
  </section>

  <Section id="gdzie-kupic" title="Znajdź salon partnerski" lead={steps.lead} class="section--alt section--center">
    <StoreFinder id="salony-home" limit={3} headingLevel={3} more={{ label: 'Wszystkie salony na mapie', href: url.stores() }} />
    <ol class="buy-steps">
      {steps.items.map((it: any) => (
        <li><h3><Rich text={it.title} /></h3><p><Rich text={it.text} /></p></li>
      ))}
    </ol>
  </Section>

  <section class="band-dark on-dark" id={b2b.id} aria-labelledby="b2b-tytul">
    <div class="container band-dark__inner">
      <div data-reveal>
        <h2 id="b2b-tytul"><Rich text={b2b.title} /></h2>
        <p><Rich text={b2b.text} /></p>
        <ul>
          {['Twój salon w wyszukiwarce „Gdzie kupić”', 'Cennik partnerski i stany magazynowe online', 'Zamówienia przez strefę partnera'].map(t => (
            <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.5 4.5L19 7" /></svg>{t}</li>
          ))}
        </ul>
        <p class="cta-row">
          <a class="btn btn--white" href={url.partners}>{b2b.cta.label}</a>
          <a class="btn btn--light" href={url.partnerZone}>Strefa partnera</a>
        </p>
      </div>
      <div data-reveal style="--d: 120ms">
        <Media image={b2bImg} alt="" widths={[480, 768, 1024]} sizes="(min-width: 60rem) 38rem, 100vw" ratio="16 / 10" placeholderLabel="Aranżacja" />
      </div>
    </div>
  </section>

  <Section id="rodzaje" title="Wybierz rodzaj mebla" class="section--center">
    <ul class="type-tiles">
      {tileTypes.map(({ t, img }) => (
        <li class="type-tile"><a href={url.category(t.slug)}>
          <span class="type-tile__thumb">{img && <Image src={img.src} alt="" widths={[160, 240, 320]} sizes="(min-width: 60rem) 9rem, 22vw" loading="lazy" />}</span>
          <span class="type-tile__name">{t.plural}</span>
        </a></li>
      ))}
    </ul>
    <p class="section__more"><a href={url.products}>Wszystkie {typeCount} rodzajów mebli</a></p>
  </Section>

  <Section id={guides.id} title={guides.title} lead={guides.lead} class="section--center">
    <ul class="card-grid card-grid--articles">
      {articles.map(a => <ArticleCard article={a} />)}
    </ul>
    <p class="section__more"><a href={guides.cta.href}>{guides.cta.label}</a></p>
  </Section>

  <Faq title={page.faq.title} items={page.faq.items} />
  <PriceData products={featured} />
</BaseLayout>
