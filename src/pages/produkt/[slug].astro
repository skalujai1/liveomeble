---
// Mebel — docs/ia.md 3.7, szablon: src/content/pages/produkt.json. Dane: karta produktu Liveo (products.json).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Media from '../../components/Media.astro';
import PriceBlock from '../../components/PriceBlock.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import StoreFinder from '../../components/StoreFinder.astro';
import ContentSection from '../../components/ContentSection.astro';
import Faq from '../../components/Faq.astro';
import { collectionImage, packshotFor, srcOf, type PublicImage } from '../../lib/images';
import { abs, faqPage, productLd, webPage, type VariantLd } from '../../lib/jsonld';
import {
  collectionOf, defaultVariant, dimsLong, finishById, num, pages, products, productsSorted, site, typeOf, url,
  type Product,
} from '../../lib/site';
import { fill, firstSentence, listJoin, lowerFirst } from '../../lib/text';

export function getStaticPaths() {
  return products.map(p => ({ params: { slug: p.slug }, props: { p } }));
}
interface Props { p: Product }
const { p } = Astro.props;
const tpl = pages.produkt;
const sec = (id: string) => tpl.sections.find(s => s.id === id) as any;
const c = collectionOf(p);
// Kolekcja w aranżacji (panorama 2:1): pas na pełną szerokość między szczegółami a sekcją gdzie kupić.
const scene = collectionImage(c, 'cinema');
const t = typeOf(p);
const path = url.product(p.slug);
const dv = defaultVariant(p);
const colorLabels = listJoin(p.variants.map(v => lowerFirst(v.colorLabel)));

// Komplet: ta sama kolekcja i kolor, wspólne pomieszczenie; maks. 6, bez bieżącego (i bez innych rozmiarów tego samego modelu).
const komplet = productsSorted
  .filter(x => x.collection === p.collection && x.sku !== p.sku && x.rooms.some(r => p.rooms.includes(r)) && x.variants.some(v => v.code === dv.code))
  .filter((x, i, all) => all.findIndex(y => y.sku === x.sku) === i)
  .slice(0, 6);
const siblingTypes = [...new Set(komplet.map(x => lowerFirst(typeOf(x).plural)))];

const packages = (p.packages ?? []) as { ean: string | null; w: number | null; h: number | null; d: number | null; kg: number | null }[];
const packagesGross = packages.reduce((a, x) => a + (x.kg ?? 0), 0);
const plPaczki = (n: number) => (n === 1 ? 'paczka' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? 'paczki' : 'paczek');
const packagesText = packages.length ? `${packages.length} ${plPaczki(packages.length)}${packagesGross ? `, razem ok. ${num(Math.round(packagesGross * 10) / 10)} kg` : ''}` : '';

const vars: Record<string, string | number | null | undefined> = {
  name: p.name, colorLabel: dv.colorLabel, collectionName: c.name, collection: c.slug, dimsLong: dimsLong(p),
  w: num(p.dims.w), h: num(p.dims.h), d: num(p.dims.d), weightKg: p.weightKg ? num(p.weightKg) : null,
  assembly: p.assembly, equipment: p.equipment ?? 'instrukcja montażu i akcesoria montażowe', colorLabels,
  siblingTypesList: listJoin(siblingTypes), description: p.description, sku: dv.sku, ean: dv.ean, packagesText,
  weightSentence: p.weightKg ? ` Waży ok. ${num(p.weightKg)} kg netto.` : '',
  packagesSentence: packages.length ? `${p.name} przychodzi w ${packages.length} ${packages.length === 1 ? 'paczce' : 'paczkach'}${packagesGross ? ` o łącznej wadze ok. ${num(Math.round(packagesGross * 10) / 10)} kg` : ''}. Wymiary paczek są w sekcji „Wymiary”.` : '',
};

// <title>: „{name} — {kolor} | Liveo” → za długi: „{name} — wymiary i kolory | Liveo” → „{name} | Liveo”.
let title = fill(tpl.seo.title, vars);
if (title.length > 60) title = fill(tpl.seo.titleLong, vars);
if (title.length > 60) title = `${p.name}${site.brand.titleSuffix}`;
// description: nazwa + wymiary, pierwsze zdanie opisu, kolory — przycinane całymi zdaniami do 155 znaków.
const descParts = [`${p.name}: ${dimsLong(p)}.`, p.description ? firstSentence(p.description) : '', `Kolory: ${p.variants.map(v => v.colorLabel).join(', ')}.`].filter(Boolean);
let description = descParts.join(' ');
if (description.length > tpl.seo.descriptionMax) description = descParts.slice(0, 2).join(' ');
if (description.length > tpl.seo.descriptionMax) description = descParts[0];

const faq = tpl.faq.items
  .filter(it => !('showIf' in it) || (it.showIf === 'packages' ? packages.length > 0 : p.assembly === 'do samodzielnego montażu'))
  .filter(it => !it.a.includes('{siblingTypesList}') || siblingTypes.length > 0)
  .map(it => ({ q: fill(it.q, vars), a: fill(it.a, vars) }));

// Warianty: zdjęcie główne, dodatkowe zdjęcia z karty (serwer Liveo), próbki kolorów.
const hex = (id?: string | null) => (id && finishById.get(id)?.hex) || '#ccc';
const variants = p.variants.map(v => {
  const img = packshotFor(p, v);
  const alt = img?.approximate
    ? `${p.name} — aranżacja kolekcji ${c.name}`
    : fill(sec('galeria').imageAlt[0], { name: p.name, colorLabel: v.colorLabel.toLocaleLowerCase('pl') });
  const ldImage = img?.pub && !img.approximate ? srcOf(img.pub, 1000) : undefined;
  // dodatkowe zdjęcia z karty (serwer Liveo): bez pierwszego — to packshot powyżej
  const extra = (v.gallery ?? []) as PublicImage[];
  return { v, img, alt, ldImage, extra, c1: hex(v.finish.front), c2: hex(v.finish.body ?? v.finish.front) };
});
const descriptions = [...new Set(p.variants.map(v => v.description).filter(Boolean))];
// Obraz OG: packshot wariantu domyślnego na lnianym tle 1200×630 (src/pages/og).
const ogImage = variants[0].ldImage ? `/og/produkty/${p.slug}.jpg` : null;

const ld: VariantLd[] = variants.map(({ v, ldImage }) => ({
  code: v.code, sku: v.sku, gtin13: v.ean, color: v.colorLabel, url: url.product(p.slug, v.code), image: ldImage,
}));
const summary = sec('podsumowanie');
const dimsSec = sec('wymiary');
const shop = sec('gdzie-kupic');
const kompletSec = sec('komplet');
const specSec = sec('specyfikacja');
const filesSec = sec('pliki');
const docs = Object.entries(p.documents ?? {}).filter(([, href]) => href) as [keyof typeof filesSec.items, string][];
const dimRows = dimsSec.rows.filter((r: any) => vars[r.key] != null && vars[r.key] !== '' && vars[r.key] !== '—');
---
<BaseLayout
  {title}
  {description}
  {path}
  pageClass="page-product"
  ogType="product"
  {ogImage}
  ogImageAlt={variants[0].alt}
  breadcrumbs={[{ name: 'Meble', url: url.products }, { name: t.plural, url: url.category(t.slug) }, { name: p.name, url: path }]}
  jsonLd={[
    webPage('ItemPage', { path, title, description, hasBreadcrumb: true, extra: { mainEntity: { '@id': `${abs(path)}#product` } } }),
    productLd({ path, name: p.name, description: p.description ?? description, sku: p.sku, category: t.plural, dims: p.dims, weightKg: p.weightKg, variants: ld }),
    faqPage(path, faq),
  ]}
>
  <article class="product container" data-product-page data-default-variant={dv.code}>
    <header class="product__head">
      <p class="summary__collection"><a href={url.collection(c.slug)}>{fill(summary.collectionLink, vars)}</a></p>
      <h1 class="summary__title">{p.name}</h1>
      <p class="summary__dims">{dimsLong(p)}</p>
    </header>

    <section class="product__gallery gallery" id="galeria" aria-label={fill(sec('galeria').ariaLabel, vars)}>
      {variants.map(({ v, img, alt }) => (
        <figure class:list={['gallery__item', { 'is-active': v.code === dv.code }]} data-gallery-item data-variant={v.code}>
          <Media
            image={img}
            alt={alt}
            widths={[480, 1000]}
            sizes="(min-width: 64rem) 55vw, 100vw"
            ratio="4 / 3"
            fit={img?.approximate ? 'cover' : 'contain'}
            priority={v.code === dv.code}
            placeholderLabel={t.name}
          />
          <figcaption class="gallery__caption">{v.colorLabel}</figcaption>
        </figure>
      ))}
      {variants.map(({ v, extra }) => extra.length > 0 && (
        <ul class="gallery__more" data-variant-only data-variant={v.code} hidden={v.code !== dv.code} aria-label={fill(sec('galeria').more, vars)}>
          {extra.map((g, i) => (
            <li>
              <a href={srcOf(g, 1000)} target="_blank" rel="noopener">
                <img src={srcOf(g, 1000)} alt={fill(sec('galeria').moreAlt, { name: p.name, colorLabel: v.colorLabel.toLocaleLowerCase('pl'), i: i + 2 })} loading="lazy" decoding="async" width={g.w} height={g.h} sizes="(min-width: 64rem) 12rem, 30vw" />
              </a>
            </li>
          ))}
        </ul>
      ))}
      <p class="gallery__disclaimer">{sec('galeria').colorDisclaimer}</p>
    </section>

    <div class="product__summary summary">
      <fieldset class="variants" data-variant-picker>
        <legend class="variants__legend">
          <span class="visually-hidden">{summary.colorGroupLabel}. </span>
          <span data-color-title data-template={summary.colorTitle}>{fill(summary.colorTitle, vars)}</span>
        </legend>
        <ul class="variants__list">
          {variants.map(({ v, c1, c2 }) => (
            <li>
              <label class="variant">
                <input type="radio" name="kolor" value={v.code} checked={v.code === dv.code} data-label={v.colorLabel} />
                <span class="variant__chip" style={`--c1: ${c1}; --c2: ${c2}`} aria-hidden="true"></span>
                <span class="variant__text"><span>{v.colorLabel}</span></span>
              </label>
            </li>
          ))}
        </ul>
      </fieldset>

      <PriceBlock product={p} />
      {p.delivery72 && <p class="stock stock--dostepny">{summary.delivery}</p>}
      {p.assembly && <p class="summary__assembly">{fill(summary.assembly, vars)}</p>}
      {variants.map(({ v }) => (
        <p class="summary__codes" data-variant-only data-variant={v.code} hidden={v.code !== dv.code}>
          {fill(summary.codes, { sku: v.sku })}{v.ean && <> · {fill(summary.ean, { ean: v.ean })}</>}
        </p>
      ))}
      <p class="cta-row">
        <a class="btn btn--primary" href={summary.ctaPrimary.href}>{summary.ctaPrimary.label}</a>
        {komplet.length > 0 && <a class="btn btn--secondary" href={summary.ctaSecondary.href}>{fill(summary.ctaSecondary.label, vars)}</a>}
      </p>
    </div>
  </article>

  {descriptions.length > 0 && (
    <Section id="opis" title={sec('opis').title} width="narrow">
      {variants.filter(({ v }) => v.description).map(({ v }) => (
        <div class="prose" data-variant-only data-variant={v.code} hidden={descriptions.length > 1 ? v.code !== dv.code : v !== variants.find(x => x.v.description)!.v}>
          <p>{v.description}</p>
        </div>
      ))}
    </Section>
  )}

  <Section id="wymiary" title={dimsSec.title} lead={dimsSec.lead}>
    <div class="dims-layout">
      <div>
        <table class="data-table">
          <caption class="visually-hidden">{dimsSec.title}: {p.name}</caption>
          <tbody>
            {dimRows.map((r: any) => (
              <tr><th scope="row">{r.label}</th><td>{fill(r.value, vars)}</td></tr>
            ))}
          </tbody>
        </table>
        {packages.length > 0 && (
          <table class="data-table data-table--packages">
            <caption>{dimsSec.packagesCaption}</caption>
            <thead><tr>{dimsSec.packageCols.map((h: string) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>
              {packages.map((x, i) => (
                <tr>
                  <th scope="row">{i + 1}</th>
                  <td>{[x.w, x.h, x.d].map(n => num(n)).join(' × ')}</td>
                  <td>{x.kg ? `${num(x.kg)} kg` : '—'}</td>
                  <td>{x.ean ?? '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
      {p.drawing && (
        <figure class="dims-drawing dims-drawing--photo">
          <img src={srcOf(p.drawing as PublicImage, 1200)} alt={fill(dimsSec.drawingAlt, vars)} loading="lazy" decoding="async" width={(p.drawing as PublicImage).w} height={(p.drawing as PublicImage).h} />
        </figure>
      )}
    </div>
    <p class="section__more"><a href={dimsSec.guideLink.href}>{dimsSec.guideLink.label}</a></p>
  </Section>

  {p.specs.length > 0 && (
    <Section id="specyfikacja" title={specSec.title} lead={specSec.lead} width="narrow">
      <table class="data-table">
        <caption class="visually-hidden">{specSec.title}: {p.name}</caption>
        <tbody>
          {p.specs.map(r => <tr><th scope="row">{r.label}</th><td>{r.value}</td></tr>)}
        </tbody>
      </table>
    </Section>
  )}

  {docs.length > 0 && (
    <Section id="pliki" title={filesSec.title} lead={filesSec.note} width="narrow">
      <ul class="doc-links">
        {docs.map(([k, href]) => (
          <li><a class="link" href={href} target="_blank" rel="noopener">{filesSec.items[k]}<span class="visually-hidden"> (otwiera się w nowej karcie)</span></a></li>
        ))}
      </ul>
    </Section>
  )}

  {scene && (
    <section class="product-scene on-dark" aria-labelledby="w-aranzacji">
      <figure class="product-scene__fig" data-reveal>
        <Media image={scene} alt={`Kolekcja ${c.name} w aranżacji`} widths={[1280, 2400]} sizes="100vw" ratio="2 / 1" placeholderLabel={`Kolekcja ${c.name}`} />
      </figure>
      <div class="container product-scene__caption">
        <h2 class="product-scene__title" id="w-aranzacji">Kolekcja {c.name} w aranżacji</h2>
        <a class="link" href={url.collection(c.slug)}>Zobacz całą kolekcję {c.name}</a>
      </div>
    </section>
  )}

  <Section id="gdzie-kupic" title={fill(shop.title, vars)} lead={fill(shop.lead, vars)} class="section--alt">
    <StoreFinder id="sklepy-mebel" presetCollection={c.slug} limit={shop.limit} more={{ label: shop.more.label, href: fill(shop.more.href, vars) }} note={shop.note} />
  </Section>

  {komplet.length > 0 && (
    <Section id="komplet" title={fill(kompletSec.title, vars)} lead={kompletSec.lead}>
      <ProductGrid products={komplet} code={dv.code} />
      <p class="section__more"><a href={fill(kompletSec.more.href, vars)}>{fill(kompletSec.more.label, vars)}</a></p>
    </Section>
  )}

  <ContentSection s={sec('doradca')} />

  <Faq title={tpl.faq.title} items={faq} />
</BaseLayout>

<script>
  import { initProductPage } from '../../scripts/product';
  initProductPage();
</script>
