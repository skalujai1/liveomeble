---
// Wszystkie meble z filtrami — docs/ia.md 3.4, treść: src/content/pages/meble.json
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import ContentSection from '../../components/ContentSection.astro';
import ProductListing from '../../components/ProductListing.astro';
import CategoryTiles from '../../components/CategoryTiles.astro';
import Faq from '../../components/Faq.astro';
import { faqPage, itemList, webPage } from '../../lib/jsonld';
import { pages, productsSorted, section, url } from '../../lib/site';

const page = pages.meble;
const path = url.products;
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  {path}
  pageClass="page-products"
  breadcrumbs={[{ name: 'Meble', url: path }]}
  jsonLd={[
    webPage('CollectionPage', { path, title: page.seo.title, description: page.seo.description, hasBreadcrumb: true }),
    itemList(path, productsSorted.map(p => ({ url: url.product(p.slug), name: p.name })), page.h1),
    faqPage(path, page.faq.items),
  ]}
>
  <PageHeader h1={page.h1} lead={section(page, 'wstep').lead} />

  {page.sections.slice(1).map((s: any) => {
    if (s.type === 'categories') return (
      <Section id={s.id} title={s.title}>
        <CategoryTiles />
      </Section>
    );
    if (s.type === 'product-listing') return (
      <Section id={s.id} title={s.title} titleHidden={s.titleVisuallyHidden}>
        <ProductListing products={productsSorted} action={path} />
      </Section>
    );
    return <ContentSection s={s} />;
  })}

  <Faq title={page.faq.title} items={page.faq.items} />
</BaseLayout>
