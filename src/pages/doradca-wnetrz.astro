---
// Doradca wnętrz — docs/ia.md 3.12, treść: src/content/pages/doradca-wnetrz.json, widżet: liveo-assistant/
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContentSection from '../components/ContentSection.astro';
import Faq from '../components/Faq.astro';
import { faqPage, webPage } from '../lib/jsonld';
import { roomImage } from '../lib/images';
import { pages, section, url } from '../lib/site';

const page = pages.doradca;
const path = url.advisor;
const hero = section(page, 'hero');
// Obraz nagłówka: aranżacja (atrapa 3D do czasu zdjęć od Liveo).
const heroImg = roomImage('sypialnia', 'wide');
const heroAlt = heroImg?.title ? `Aranżacja: ${heroImg.title}` : '';
---
<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  {path}
  pageClass="page-advisor"
  breadcrumbs={[{ name: page.h1, url: path }]}
  jsonLd={[webPage('WebPage', { path, title: page.seo.title, description: page.seo.description, hasBreadcrumb: true }), faqPage(path, page.faq.items)]}
>
  <PageHeader image={heroImg} imageAlt={heroAlt} placeholderLabel="Aranżacja" h1={page.h1} lead={hero.lead} ctas={hero.cta} note={hero.aiNote}>
    <noscript><p class="page-header__note">Doradca wnętrz działa w przeglądarce i wymaga włączonego JavaScriptu. Bez niego przejrzyj <a href="/kolekcje/">kolekcje</a>.</p></noscript>
  </PageHeader>

  {page.sections.slice(1).map((s: any) => <ContentSection s={s} />)}

  <Faq title={page.faq.title} items={page.faq.items} />
</BaseLayout>
