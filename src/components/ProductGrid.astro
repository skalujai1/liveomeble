---
// Siatka kart mebli (bez filtrów).
import ProductCard from './ProductCard.astro';
import type { Product } from '../lib/site';

interface Props {
  products: Product[];
  /** Kod koloru dla wszystkich kart (komplet w jednym kolorze). */
  code?: string;
  headingLevel?: 3 | 4;
  label?: string;
  /** Np. "product-grid--4": stała liczba kolumn zamiast auto-fill. */
  class?: string;
}
const { products, code, headingLevel = 3, label, class: cls } = Astro.props;
---
<ul class:list={['product-grid', cls]} aria-label={label}>
  {products.map((p, i) => <ProductCard product={p} code={code} headingLevel={headingLevel} order={i} />)}
</ul>
