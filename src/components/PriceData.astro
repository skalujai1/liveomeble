---
// Osadzone dane do przeliczenia cen w przeglądarce (scripts/prices.ts) i skrypt cen (defer, moduł).
// Tylko meble z tej strony + promocje aktywne i zaplanowane (promocja włącza i wyłącza się sama o czasie).
import { BUILD_NOW, site, upcomingOrActivePromos, type Product } from '../lib/site';

interface Props { products: Product[] }
const { products } = Astro.props;

const data = {
  builtAt: BUILD_NOW.toISOString(),
  promotions: upcomingOrActivePromos.map(({ id, label, kind, value, scope, startsAt, endsAt }) => ({ id, label, kind, value, scope, startsAt, endsAt })),
  products: Object.fromEntries(
    [...new Map(products.map(p => [p.sku, p])).values()].map(p => [
      p.sku,
      {
        sku: p.sku,
        collection: p.collection,
        type: p.type,
        basePrice: p.basePrice,
        priceHistory: p.priceHistory,
        variants: p.variants.map(v => ({ code: v.code, sku: v.sku, stock: v.stock, leadTimeDays: (v as { leadTimeDays?: number }).leadTimeDays ?? null })),
      },
    ]),
  ),
  t: {
    label: site.price.label,
    promo: site.price.promo,
    lowest30: site.price.lowest30,
    promoUntil: site.price.promoUntil,
    stock: site.stock,
  },
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<script type="application/json" is:inline data-liveo-prices set:html={json} />
<script>
  import { initPrices } from '../scripts/prices';
  initPrices();
</script>
