---
// Zamiast ceny: karty produktu Liveo nie mają cen detalicznych — cenę i dostępność podaje salon partnerski.
// Link prowadzi do wyszukiwarki salonów z wybraną kolekcją.
import { site, url, type Product } from '../lib/site';

interface Props { product: Product }
const { product } = Astro.props;
const t = site.price;
---
<div class="price price--store">
  <p class="price__main">{t.inStore}</p>
  <p class="price__note">{t.inStoreNote} <a href={url.stores(product.collection)}>{t.inStoreLink}</a></p>
</div>
