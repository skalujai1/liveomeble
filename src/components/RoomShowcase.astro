---
// Pomieszczenia jako lista nazw w Gloocku; najechanie albo fokus podmienia duże zdjęcie obok (desktop, [data-showcase]
// w src/scripts/motion.ts). Na telefonie każda pozycja ma własne zdjęcie. Bez JS: pierwsze zdjęcie i zwykłe linki.
import Media from './Media.astro';
import { roomImage } from '../lib/images';
import { productCount, productsByRoom, rooms, url } from '../lib/site';

const list = rooms.map(r => ({ r, img: roomImage(r.slug, 'wide'), n: productsByRoom(r.slug).length }));
---
<div class="showcase" data-showcase>
  <ul class="showcase__list">
    {list.map(({ r, img, n }, i) => (
      <li class:list={['showcase__item', { 'is-active': i === 0 }]} data-showcase-item>
        <a class="showcase__link" href={url.room(r.slug)}>
          <span class="showcase__thumb" aria-hidden="true">
            <Media image={img} alt="" widths={[480, 720]} sizes="92vw" ratio="16 / 10" placeholderLabel={r.name} />
          </span>
          <span class="showcase__name">{r.name}</span>
          <span class="showcase__count">{productCount(n)}</span>
          <svg class="ico showcase__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </li>
    ))}
  </ul>
  <div class="showcase__stage" aria-hidden="true">
    {list.map(({ r, img }, i) => (
      <div class:list={['showcase__pic', { 'is-active': i === 0 }]} data-showcase-pic>
        <Media image={img} alt="" widths={[720, 1080, 1440, 1920]} sizes="(min-width: 64rem) 52vw, 0px" ratio="4 / 3" placeholderLabel={r.name} />
      </div>
    ))}
  </div>
</div>
