---
// Obraz: zdjęcie katalogu (gotowe WebP z public/katalog, srcset) albo obraz z src/assets (astro:assets, AVIF + WebP);
// gdy zdjęcia nie ma — placeholder z nazwą rodzaju mebla. Brak pliku nie psuje budowy.
import { Picture } from 'astro:assets';
import { srcOf, srcsetOf, type ImageRef } from '../lib/images';

interface Props {
  image: ImageRef | null;
  alt: string;
  widths: number[];
  sizes: string;
  /** Obraz LCP: eager + fetchpriority=high. Pozostałe: lazy. */
  priority?: boolean;
  /** Proporcje ramki, np. "4 / 3" — rezerwuje miejsce (bez przesunięć układu). */
  ratio?: string;
  fit?: 'cover' | 'contain';
  /** Podpis placeholdera (np. „Szafka RTV”). */
  placeholderLabel: string;
  class?: string;
}
const { image, alt, widths, sizes, priority = false, ratio = '4 / 3', fit = 'cover', placeholderLabel, class: cls } = Astro.props;
const src = image?.src;
const format = src?.format;
const fitted = src ? widths.filter(w => w <= src.width) : [];
if (src && !fitted.length) fitted.push(src.width);
const pub = image?.pub;
---
<div class:list={['media', `media--${fit}`, { 'media--placeholder': !image, 'media--approx': image?.approximate }, cls]} style={`--media-ratio: ${ratio}`}>
  {pub ? (
    <img
      class="media__img"
      src={srcOf(pub, Math.max(...widths.filter(w => w <= 1400)))}
      srcset={srcsetOf(pub)}
      {sizes}
      width={pub.w}
      height={pub.h}
      {alt}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  ) : src ? (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat={format === 'jpg' || format === 'jpeg' ? 'jpg' : 'webp'}
      widths={fitted}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="media__img"
    />
  ) : (
    <div class="media__placeholder" role="img" aria-label={`${alt} — zdjęcie w przygotowaniu`}>
      <span class="media__placeholder-label" aria-hidden="true">{placeholderLabel}</span>
    </div>
  )}
  {image?.approximate && <span class="media__note" aria-hidden="true">Zdjęcie poglądowe</span>}
</div>
