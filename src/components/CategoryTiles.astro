---
// Kafle rodzajów mebli z miniaturą (packshot pierwszego mebla danego rodzaju) i liczbą mebli — linki do /meble/<kategoria>/.
// Siatka 4 kolumn na telefonie i 8 na desktopie (jak „Wybierz rodzaj mebla” na stronie głównej).
import Thumb from './Thumb.astro';
import { typeImage } from '../lib/images';
import { productCount, products, productsByType, types, url, type FurnitureType } from '../lib/site';

interface Props { list?: FurnitureType[]; headingLevel?: 3 | 4; current?: string }
const { list = types, current } = Astro.props;
const tiles = list.map(t => ({ t, img: typeImage(t.id, products), count: productsByType(t.id).length })).filter(x => x.count > 0);
---
<ul class="type-tiles">
  {tiles.map(({ t, img, count }) => (
    <li class="type-tile">
      <a href={url.category(t.slug)} aria-current={current === t.slug ? 'page' : undefined}>
        <span class="type-tile__thumb"><Thumb image={img} sizes="(min-width: 60rem) 9rem, 22vw" /></span>
        <span class="type-tile__name">{t.plural}</span>
        <span class="type-tile__count">{productCount(count)}</span>
      </a>
    </li>
  ))}
</ul>
