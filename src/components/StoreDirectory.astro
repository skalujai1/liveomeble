---
// Pełna lista salonów według województw — w HTML (bez JS, dla czytników i wyszukiwarek). Dane: baza salonów (xlsx).
// Kafel na województwo (liczba salonów i miasta widoczne od razu), szczegóły po rozwinięciu; salony za granicą na końcu.
// Kotwica #woj-<slug> otwiera kafel (województwa na mapie prowadzą tutaj).
import { resellers, site } from '../lib/site';
import { plural, slugify } from '../lib/text';

interface Props { headingLevel?: 2 | 3 }
const { headingLevel = 3 } = Astro.props;
const groups = [...new Set(resellers.map(r => r.voivodeship))]
  .sort((a, b) => Number(a === 'Słowenia') - Number(b === 'Słowenia') || a.localeCompare(b, 'pl'))
  .map(v => ({ name: v, stores: resellers.filter(r => r.voivodeship === v).sort((a, b) => a.city.localeCompare(b.city, 'pl') || a.name.localeCompare(b.name, 'pl')) }));
const H = `h${headingLevel}` as 'h2' | 'h3';
const route = (s: (typeof resellers)[number]) =>
  `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${s.address}, ${s.postcode} ${s.city}${s.country === 'SI' ? ', Słowenia' : ''}`)}`;
---
<div class="store-directory">
  {groups.map(g => (
    <details class="store-directory__group" id={`woj-${slugify(g.name)}`}>
      <summary class="store-directory__summary">
        <span class="store-directory__title">{g.name.charAt(0).toLocaleUpperCase('pl') + g.name.slice(1)}</span>
        <span class="store-directory__count">{plural(site.plural.stores, g.stores.length)}</span>
        <span class="store-directory__meta">{[...new Set(g.stores.map(s => s.city))].join(', ')}</span>
      </summary>
      <ul class="store-directory__list">
        {g.stores.map(s => (
          <li class="store store--compact">
            <H class="store__name">{s.name}</H>
            <p class="store__address">{s.address}, {s.postcode} {s.city}</p>
            {s.offer.length > 0 && <p class="store__offer">Oferta: {s.offer.join(', ')}</p>}
            {s.approx && <p class="store__approx">Pinezka jest przybliżona. Dokładny adres sprawdź przed wyjazdem.</p>}
            <p class="store__actions"><a href={route(s)} target="_blank" rel="noopener" aria-label={`Wyznacz trasę do: ${s.name} (otwiera mapę w nowej karcie)`}>Wyznacz trasę</a></p>
          </li>
        ))}
      </ul>
    </details>
  ))}
</div>
