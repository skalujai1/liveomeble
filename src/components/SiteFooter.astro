---
// Stopka (kierunek C), zwarta: na komputerze jeden rząd (marka z kontaktem i cztery kolumny linków), pod nim
// indeks kolekcji, na dole prawo i notka DEMO. Na telefonie kolumny i kolekcje są zwinięte (details). Treść: src/content/pages/site.json → footer.
import { CONSENT_SCRIPTS, DEMO } from '../config';
import { collections, products, rooms, site, types, url, year } from '../lib/site';
import { fill, sierotki } from '../lib/text';

const f = site.footer;
type Link = { label: string; href: string };
type Col = { title: string; items: Link[]; more?: Link };
const count = (typeId: string) => products.filter(p => p.type === typeId).length;
const columns: Col[] = f.columns.map((col: any): Col => {
  if (col.source === 'rooms') return { ...col, items: rooms.map(r => ({ label: r.name, href: url.room(r.slug) })) };
  if (col.source === 'types') return {
    ...col,
    items: types.filter(t => count(t.id) > 0).sort((a, b) => count(b.id) - count(a.id)).slice(0, col.limit ?? 8)
      .map(t => ({ label: t.plural, href: url.category(t.slug) })),
  };
  return col;
});
const legal = f.legal.filter(l => !('action' in l) || CONSENT_SCRIPTS.length > 0);
const c = f.contact;
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <img src="/brand/liveo-logo.svg" alt="Liveo Meble" width="96" height="36" loading="lazy" />
        <p class="site-footer__lead">{sierotki(f.lead)}</p>
        <address class="site-footer__contact">
          <a href={c.phoneHref}>{c.phone}</a>
          <a href={`mailto:${c.email}`}>{c.email}</a>
          <span>Liveo Meble sp. z o.o., {c.address}</span>
        </address>
        <p class="site-footer__cta">
          <a class="btn btn--light" href={url.stores()}>Gdzie kupić</a>
          <a class="link" href={url.advisor}>Doradca wnętrz</a>
        </p>
      </div>

      {columns.map((col, i) => (
        <nav class="site-footer__col" aria-labelledby={`stopka-${i}`}>
          <details class="site-footer__fold" open data-fold>
            <summary><h2 class="site-footer__title" id={`stopka-${i}`}>{col.title}</h2></summary>
            <ul class="site-footer__list">
              {col.items.map(it => <li><a href={it.href}>{it.label}</a></li>)}
              {col.more && <li class="site-footer__more"><a href={col.more.href}>{col.more.label}</a></li>}
            </ul>
          </details>
        </nav>
      ))}
    </div>

    <nav class="site-footer__collections" aria-labelledby="stopka-kolekcje">
      <details class="site-footer__fold" open data-fold>
        <summary><h2 class="site-footer__title" id="stopka-kolekcje">{f.collectionsTitle} <span>{collections.length}</span></h2></summary>
        <ul>
          {collections.map(col => <li><a href={url.collection(col.slug)}>{col.name}</a></li>)}
        </ul>
      </details>
    </nav>

    <div class="site-footer__bottom">
      <p class="site-footer__copy">{fill(f.copyright, { year })}</p>
      <ul class="site-footer__legal">
        {legal.map(l => (
          <li>
            {'href' in l && l.href
              ? <a href={l.href}>{l.label}</a>
              : <button type="button" class="link-button" data-open-consent>{l.label}</button>}
          </li>
        ))}
      </ul>
      {DEMO && <p class="site-footer__demo"><strong>DEMO.</strong> {f.demoNotice}</p>}
    </div>
  </div>
</footer>

<script>
  // Na telefonie listy stopki są zwinięte (rozwija je stuknięcie w nagłówek); na komputerze zawsze rozwinięte
  // i nieklikalne. Bez JS wszystko jest rozwinięte.
  const wide = matchMedia('(min-width: 64rem)');
  const folds = [...document.querySelectorAll<HTMLDetailsElement>('.site-footer [data-fold]')];
  const sync = () => folds.forEach(d => { d.open = wide.matches; });
  sync();
  wide.addEventListener('change', sync);
  folds.forEach(d => d.querySelector('summary')?.addEventListener('click', e => { if (wide.matches) e.preventDefault(); }));
</script>
